cmake_minimum_required(VERSION 3.21)

set(BUILD_DIR "@CMAKE_BINARY_DIR@")
set(APPDIR "${BUILD_DIR}/AppDir")
set(TOOLS_DIR "${BUILD_DIR}/appimage-tools")
set(DIST_DIR "${BUILD_DIR}/dist")
set(APPIMAGE "${DIST_DIR}/EbonholdUpdater-@PROJECT_VERSION@-x86_64.AppImage")
set(QMAKE_EXECUTABLE "@EBONHOLD_QMAKE@")

if(NOT "@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    message(FATAL_ERROR "The AppImage target can only be built on Linux.")
endif()

if(NOT "@CMAKE_SYSTEM_PROCESSOR@" MATCHES "^(x86_64|amd64|AMD64)$")
    message(FATAL_ERROR "This packaging target currently supports x86_64 only (detected: @CMAKE_SYSTEM_PROCESSOR@).")
endif()

if(QMAKE_EXECUTABLE STREQUAL "" OR NOT EXISTS "${QMAKE_EXECUTABLE}")
    message(FATAL_ERROR
        "Qt qmake was not found. linuxdeploy-plugin-qt needs it to locate Qt resources.\n"
        "On CachyOS/Arch, qt6-base normally provides /usr/lib/qt6/bin/qmake.")
endif()

file(MAKE_DIRECTORY "${TOOLS_DIR}" "${DIST_DIR}")
file(REMOVE_RECURSE "${APPDIR}")

message(STATUS "Staging AppDir...")
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E env "DESTDIR=${APPDIR}"
            "@CMAKE_COMMAND@" --install "${BUILD_DIR}" --prefix /usr --config Release
    RESULT_VARIABLE INSTALL_RESULT
)
if(NOT INSTALL_RESULT EQUAL 0)
    message(FATAL_ERROR "cmake --install failed with exit code ${INSTALL_RESULT}")
endif()

# Bundle libssl and libcrypto as a matching pair.
# Qt loads OpenSSL dynamically, so linuxdeploy may otherwise bundle only
# libcrypto while using libssl from the host, causing version mismatches.
set(OPENSSL_BUNDLE_DIR "")

foreach(CANDIDATE_DIR IN ITEMS
    "/usr/lib/@CMAKE_LIBRARY_ARCHITECTURE@"
    "/lib/@CMAKE_LIBRARY_ARCHITECTURE@"
    "/usr/lib"
    "/lib"
)
    if(EXISTS "${CANDIDATE_DIR}/libssl.so.3"
       AND EXISTS "${CANDIDATE_DIR}/libcrypto.so.3")
        set(OPENSSL_BUNDLE_DIR "${CANDIDATE_DIR}")
        break()
    endif()
endforeach()

if(OPENSSL_BUNDLE_DIR STREQUAL "")
    message(FATAL_ERROR
        "Could not find a matching libssl.so.3/libcrypto.so.3 pair.")
endif()

file(MAKE_DIRECTORY "${APPDIR}/usr/lib")

file(COPY_FILE
    "${OPENSSL_BUNDLE_DIR}/libssl.so.3"
    "${APPDIR}/usr/lib/libssl.so.3"
    ONLY_IF_DIFFERENT
)

file(COPY_FILE
    "${OPENSSL_BUNDLE_DIR}/libcrypto.so.3"
    "${APPDIR}/usr/lib/libcrypto.so.3"
    ONLY_IF_DIFFERENT
)

message(STATUS "Bundled matching OpenSSL libraries from ${OPENSSL_BUNDLE_DIR}")

function(download_appimage URL PATH EXPECTED_SHA256)
    set(NEEDS_DOWNLOAD TRUE)

    if(EXISTS "${PATH}")
        file(SHA256 "${PATH}" CURRENT_SHA256)
        if("${CURRENT_SHA256}" STREQUAL "${EXPECTED_SHA256}")
            set(NEEDS_DOWNLOAD FALSE)
        else()
            message(WARNING "Cached build tool failed SHA-256 verification. Downloading it again.")
            file(REMOVE "${PATH}")
        endif()
    endif()

    if(NEEDS_DOWNLOAD)
        message(STATUS "Downloading pinned build tool: ${URL}")
        file(DOWNLOAD "${URL}" "${PATH}"
            EXPECTED_HASH "SHA256=${EXPECTED_SHA256}"
            SHOW_PROGRESS
            TLS_VERIFY ON
            STATUS DOWNLOAD_STATUS
        )
        list(GET DOWNLOAD_STATUS 0 DOWNLOAD_CODE)
        list(GET DOWNLOAD_STATUS 1 DOWNLOAD_MESSAGE)
        if(NOT DOWNLOAD_CODE EQUAL 0)
            file(REMOVE "${PATH}")
            message(FATAL_ERROR "Download failed: ${DOWNLOAD_MESSAGE}")
        endif()
    endif()

    file(SHA256 "${PATH}" VERIFIED_SHA256)
    if(NOT "${VERIFIED_SHA256}" STREQUAL "${EXPECTED_SHA256}")
        file(REMOVE "${PATH}")
        message(FATAL_ERROR "SHA-256 verification failed for ${PATH}")
    endif()

    file(CHMOD "${PATH}"
        PERMISSIONS
            OWNER_READ OWNER_WRITE OWNER_EXECUTE
            GROUP_READ GROUP_EXECUTE
            WORLD_READ WORLD_EXECUTE
    )
endfunction()

set(LINUXDEPLOY "${TOOLS_DIR}/linuxdeploy-x86_64.AppImage")
set(LINUXDEPLOY_QT "${TOOLS_DIR}/linuxdeploy-plugin-qt-x86_64.AppImage")

download_appimage(
    "https://github.com/linuxdeploy/linuxdeploy/releases/download/1-alpha-20250213-2/linuxdeploy-x86_64.AppImage"
    "${LINUXDEPLOY}"
    "4648f278ab3ef31f819e67c30d50f462640e5365a77637d7e6f2ad9fd0b4522a"
)
download_appimage(
    "https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/1-alpha-20250213-1/linuxdeploy-plugin-qt-x86_64.AppImage"
    "${LINUXDEPLOY_QT}"
    "15106be885c1c48a021198e7e1e9a48ce9d02a86dd0a1848f00bdbf3c1c92724"
)

file(REMOVE "${APPIMAGE}")

message(STATUS "Bundling Qt and creating AppImage...")
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E env
        "APPIMAGE_EXTRACT_AND_RUN=1"
        # linuxdeploy brings its own strip binary.
        # On Arch/CachyOS it can be too old for newer ELF sections like .relr.dyn.
        # Disable stripping here so the AppImage build does not fail.
        "NO_STRIP=1"
        "QMAKE=${QMAKE_EXECUTABLE}"
        "PATH=${TOOLS_DIR}:$ENV{PATH}"
        "LDAI_OUTPUT=${APPIMAGE}"
        "LINUXDEPLOY_OUTPUT_VERSION=@PROJECT_VERSION@"
        "${LINUXDEPLOY}"
        --appdir "${APPDIR}"
        --plugin qt
        --output appimage
    WORKING_DIRECTORY "${BUILD_DIR}"
    RESULT_VARIABLE LINUXDEPLOY_RESULT
)

if(NOT LINUXDEPLOY_RESULT EQUAL 0)
    message(FATAL_ERROR "linuxdeploy failed with exit code ${LINUXDEPLOY_RESULT}")
endif()

if(NOT EXISTS "${APPIMAGE}")
    message(FATAL_ERROR "linuxdeploy finished, but ${APPIMAGE} was not created.")
endif()

file(CHMOD "${APPIMAGE}"
    PERMISSIONS
        OWNER_READ OWNER_WRITE OWNER_EXECUTE
        GROUP_READ GROUP_EXECUTE
        WORLD_READ WORLD_EXECUTE
)

message(STATUS "")
message(STATUS "AppImage created successfully:")
message(STATUS "  ${APPIMAGE}")
message(STATUS "")
